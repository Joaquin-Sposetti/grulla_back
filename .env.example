# Configuración local (valores predeterminados; no requiere claves).
GRULLA_AI_PROVIDER=local
GRULLA_AI_MODEL=grulla-local
GRULLA_LOCAL_AI_URL=http://127.0.0.1:8081
# Referencia únicamente: este archivo no se carga automáticamente.

# Railway: lista de origenes HTTPS permitidos, separados por comas.
# Si se define, reemplaza FRONTEND_ORIGIN; si no, se mantiene el origen local.
# FRONTEND_ORIGINS=https://centrogrulla.netlify.app,https://centrogrulla.com.ar,https://www.centrogrulla.com.ar

# Crear el primer administrador desde Variables de Railway, sin SSH.
# Configurar las tres juntas y eliminarlas después de verificar el ingreso.
# GRULLA_INITIAL_ADMIN_NAME=Tu nombre
# GRULLA_INITIAL_ADMIN_EMAIL=admin@example.com
# GRULLA_INITIAL_ADMIN_PASSWORD=Elegir una contraseña privada de al menos 10 caracteres
# GRULLA_DATA_DIR=/data
